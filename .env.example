# EmailJS configuration for the solution-feedback form
# Sign up free at https://www.emailjs.com (200 emails/month on free tier)
# After creating an Email Service and Template, copy these values into a local .env file.
# Vite only exposes variables prefixed with VITE_ to the browser.

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
