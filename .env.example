# Power Automate flow URL for the solution-feedback form.
# In the "AI Marketplace Feedback" flow, open the
# "When an HTTP request is received" trigger and copy its HTTP POST URL.
# Paste it into a local .env file (do NOT commit the real URL).
# Vite only exposes variables prefixed with VITE_ to the browser.

VITE_FEEDBACK_FLOW_URL=https://prod-XX.region.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?api-version=...&sig=...
